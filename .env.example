# =====================================================================
# copybot 密钥与 IB Gateway 设置
# 使用: cp .env.example .env && chmod 600 .env, 然后填写下面的值。
# .env 里有密码 / token: 不要提交到 git, 不要截图发给别人。
# 值里含有 $ # 空格 等特殊字符时用单引号包起来, 例如: TWS_PASSWORD='ab$c#d'
# =====================================================================

# ---------------- Discord ----------------
# 机器人 token: Discord Developer Portal → 你的应用 → Bot → Reset Token
DISCORD_TOKEN=

# ---------------- IBKR 登录 (只给 ib-gateway 容器用) ----------------
# IBKR 用户名 / 密码
TWS_USERID=
TWS_PASSWORD=

# paper = 模拟盘, live = 实盘。务必先用 paper 跑通!
TRADING_MODE=paper

# 机器人连接 Gateway 的端口, 必须与 TRADING_MODE 对应:
#   paper → 4004    live → 4003
# (gnzsnz/ib-gateway 容器内 socat 转发端口; 端口不对时机器人连不上, 不会下错账户)
IBKR_PORT=4004

# 必须为 no: yes 表示 API 只读, 机器人无法下单
READ_ONLY_API=no

# ---------------- 2FA / 自动重启 ----------------
# 实盘账户登录需要在手机 IBKR Mobile 上确认 (2FA)。
# 超时未确认时重启登录流程, 再推送一次确认请求。
TWOFA_TIMEOUT_ACTION=restart
RELOGIN_AFTER_TWOFA_TIMEOUT=yes
# 每天自动重启 Gateway 的时间 (TIME_ZONE 时区, 格式 hh:mm AM/PM), 日常重启不需要 2FA。
# 选在休市时段 (美东 20:00 之后、次日 04:00 之前)。
AUTO_RESTART_TIME='11:59 PM'
# 可选: 每周日完整重新登录的时间 (hh:mm, TIME_ZONE 时区, 需晚于美东周日 01:00)。
# 实盘时需要你在手机上确认 2FA, 选一个你醒着的时间, 例如 '20:00'。留空 = 不设置。
TWS_COLD_RESTART=
# 有多个 2FA 设备时, 填写设备名称 (与登录界面列表中的名字完全一致)。一般留空。
TWOFA_DEVICE=

# ---------------- 其他 Gateway 设置 ----------------
# 时区: 自动重启时间按这个时区解释。建议保持美东。
TIME_ZONE=America/New_York
# API 连接经容器内 socat 转发, 自动接受即可 (API 端口不对外暴露)。
TWS_ACCEPT_INCOMING=accept
# 同一用户名在别处登录时的处理方式 (默认 primary, 一般不用改)。
EXISTING_SESSION_DETECTED_ACTION=primary
# 设为 yes = 勾选 Gateway「API → Precautions」里的各项 "Bypass ... " (包括绕过 API 订单的
# 预防性数量 / 金额限制)。如果大单因为 precaution / size limit 被拒, 改为 yes。留空 = 不改动。
BYPASS_WARNING=
# 可选: Gateway 的 Java 内存上限 (MB, 不带单位), 例如 768。2GB 内存的 VPS 一般留空即可。
JAVA_HEAP_SIZE=

# VNC 密码: 设置后可通过 SSH 隧道用 VNC 查看 Gateway 界面 (排查登录问题用)。
# 留空 = 不启动 VNC。
VNC_SERVER_PASSWORD=

# ---------------- copybot 可选覆盖 ----------------
# 留空 = 以 config.yaml 的 trading.dry_run 为准。
# true = 强制 dry-run (只算不下单); false = 强制真实下单 (慎用!)。
# 只接受 true/false/1/0/yes/no; 写错 (例如 flase) 机器人会报错拒绝启动, 不会误开实盘。
COPYBOT_DRY_RUN=
